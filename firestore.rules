rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profile document
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 256;
      allow update: if isOwner(userId) && isValidId(userId)
        && request.resource.data.uid == resource.data.uid;
      allow delete: if isOwner(userId) && isValidId(userId);

      // Backups subcollection
      match /backups/{backupId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(backupId)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.payload is string;
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(backupId)
          && request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(backupId);
      }
    }
  }
}
