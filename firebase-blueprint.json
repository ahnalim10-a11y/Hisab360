{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and sync metadata",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID"
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "description": "User display name"
        },
        "photoURL": {
          "type": "string",
          "description": "User profile avatar URL"
        },
        "signatureUrl": {
          "type": "string",
          "description": "Digital signature image data"
        },
        "lastSynced": {
          "type": "string",
          "description": "Last synchronization timestamp"
        },
        "createdAt": {
          "type": "string",
          "description": "Account initialization date"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp"
        }
      },
      "required": ["uid", "email"]
    },
    "Backup": {
      "title": "Backup",
      "description": "User ledger data backup",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "UID of the owner user"
        },
        "exportedAt": {
          "type": "string",
          "description": "Export timestamp"
        },
        "version": {
          "type": "string",
          "description": "Application schema version"
        },
        "payload": {
          "type": "string",
          "description": "Serialized JSON snapshot of ledger transactions and settings"
        },
        "createdAt": {
          "type": "string",
          "description": "Snapshot creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Snapshot update timestamp"
        }
      },
      "required": ["userId", "exportedAt", "payload"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Stores user profile and preferences"
    },
    "/users/{userId}/backups/{backupId}": {
      "schema": "Backup",
      "description": "Stores user ledger backup snapshots"
    }
  }
}
